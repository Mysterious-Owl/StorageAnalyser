@="\"C:\\Program Files\\Python310\\pythonw.exe\" \"Q:\\Scripts\\data dedup\\app\\dd_web.py\" --page storage --scan \"%V\""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\StorageExplorer\shell\2dups]
